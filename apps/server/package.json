    "@bfw/game-core": "workspace:*",
    "@bfw/game-data": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.4",
    "@types/pg": "8.20.0",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "~6.0.3"
  }

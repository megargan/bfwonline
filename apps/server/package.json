{
  "name": "@bfw/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs",

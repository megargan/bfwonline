APP_DOMAIN=example.com
# Production behind IIS only: uncomment and set the VM's actual private IPv4 address.
# BFW_PROXY_BIND=192.168.250.2
POSTGRES_DB=bfw
POSTGRES_BOOTSTRAP_USER=bfw_bootstrap
# Generate a different unique value for each password with: openssl rand -hex 32
POSTGRES_BOOTSTRAP_PASSWORD=replace_with_random_hex
APP_DB_PASSWORD=replace_with_random_hex
MIGRATION_DB_PASSWORD=replace_with_random_hex
BACKUP_DB_PASSWORD=replace_with_random_hex
# Local Compose tags. Production deployment injects and records immutable GHCR digests.
DB_IMAGE=bfw-db:local
API_IMAGE=bfw-api:local
WEB_IMAGE=bfw-web:local
